      "name": "No New Filings",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1180,
        480
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-sec-urgent",
              "leftValue": "={{ $json.isMaterialOrInsider }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "n3-09-priority",
      "name": "5. Form 4 Insider or 8-K Event?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1440,
        240
      ]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "={{ $('1. Workflow Config (Watchlist)').item.json.slackChannel }}",
          "mode": "name"
        },
        "text": "=:chart_with_upwards_trend: *{{ $json.alertHeadline }}*\n*Company:* {{ $json.companyName }} | *Form:* `{{ $json.form }}` | *Date:* {{ $json.filingDate }}\n*XBRL Snapshot:* Rev `{{ $json.latestRevenue }}` | Net Inc `{{ $json.latestNetIncome }}` | Cash `{{ $json.latestCash }}`\n<{{ $json.filingUrl }}|Read Official SEC Filing>",
        "otherOptions": {}
      },
      "id": "n3-10-slack",
      "name": "6a. Send Urgent Filing Alert (Slack)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
